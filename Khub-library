		function Tab:Slider(opts)
			opts = opts or {}
			local nameS = opts.Name or opts.Title or "Slider"
			local minV = opts.Min or 0
			local maxV = opts.Max or 100
			local default = opts.Default or minV
			local flag = opts.Flag
			local cb = opts.Callback
			local value = default

			local card = addCard()
			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, 0, 0, 18)
			lbl.BackgroundTransparency = 1
			lbl.Text = nameS .. ": " .. tostring(value)
			lbl.Font = Enum.Font.GothamMedium
			lbl.TextSize = 12
			lbl.TextColor3 = THEME.text
			lbl.TextXAlignment = Enum.TextXAlignment.Left
			lbl.ZIndex = 5
			lbl.Parent = card

			local barBg = Instance.new("Frame")
			barBg.Size = UDim2.new(1, 0, 0, 8)
			barBg.BackgroundColor3 = THEME.off
			barBg.BorderSizePixel = 0
			barBg.ZIndex = 5
			barBg.Parent = card
			corner(barBg, 4)

			local fill = Instance.new("Frame")
			fill.Size = UDim2.new((value - minV) / math.max(maxV - minV, 1), 0, 1, 0)
			fill.BackgroundColor3 = THEME.accent
			fill.BorderSizePixel = 0
			fill.ZIndex = 6
			fill.Parent = barBg
			corner(fill, 4)

			local sliding = false
			local function setFromX(x)
				local rel = math.clamp((x - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
				value = math.floor(minV + rel * (maxV - minV) + 0.5)
				fill.Size = UDim2.new(rel, 0, 1, 0)
				lbl.Text = nameS .. ": " .. tostring(value)
				if flag then Window._configFlags[flag] = value end
				if cb then pcall(cb, value) end
			end

			barBg.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					setFromX(input.Position.X)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					setFromX(input.Position.X)
				end
			end)

			if flag then Window._configFlags[flag] = value end
			return {
				Set = function(_, v)
					value = math.clamp(v, minV, maxV)
					local rel = (value - minV) / math.max(maxV - minV, 1)
					fill.Size = UDim2.new(rel, 0, 1, 0)
					lbl.Text = nameS .. ": " .. tostring(value)
					if flag then Window._configFlags[flag] = value end
				end,
				Get = function() return value end,
			}
		end

		function Tab:Dropdown(opts)
			opts = opts or {}
			local nameD = opts.Name or opts.Title or "Dropdown"
			local options = opts.Options or {}
			local default = opts.Default or options[1]
			local flag = opts.Flag
			local cb = opts.Callback
			local selected = default

			local card = addCard()
			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, 0, 0, 16)
			lbl.BackgroundTransparency = 1
			lbl.Text = nameD
			lbl.Font = Enum.Font.GothamMedium
			lbl.TextSize = 12
			lbl.TextColor3 = THEME.dim
			lbl.TextXAlignment = Enum.TextXAlignment.Left
			lbl.ZIndex = 5
			lbl.Parent = card

			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 30)
			btn.BackgroundColor3 = THEME.element
			btn.Text = "  " .. tostring(selected) .. "  ▼"
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 12
			btn.TextColor3 = THEME.text
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.ZIndex = 5
			btn.Parent = card
			corner(btn, 6)

			local open = false
			local listFrame = Instance.new("Frame")
			listFrame.Size = UDim2.new(1, 0, 0, 0)
			listFrame.AutomaticSize = Enum.AutomaticSize.Y
			listFrame.BackgroundColor3 = THEME.element
			listFrame.Visible = false
			listFrame.ZIndex = 10
			listFrame.Parent = card
			corner(listFrame, 6)
			listLayout(listFrame, Enum.FillDirection.Vertical, 2)
			pad(listFrame, 4, 4, 4, 4)

			local function pick(v)
				selected = v
				btn.Text = "  " .. tostring(selected) .. "  ▼"
				listFrame.Visible = false
				open = false
				if flag then Window._configFlags[flag] = selected end
				pushToast(ToastHost, nameD .. ": " .. tostring(selected), true)
				if cb then pcall(cb, selected) end
			end

			for _, opt in ipairs(options) do
				local o = Instance.new("TextButton")
				o.Size = UDim2.new(1, 0, 0, 26)
				o.BackgroundColor3 = THEME.card
				o.Text = "  " .. tostring(opt)
				o.Font = Enum.Font.Gotham
				o.TextSize = 12
				o.TextColor3 = THEME.text
				o.TextXAlignment = Enum.TextXAlignment.Left
				o.ZIndex = 11
				o.Parent = listFrame
				corner(o, 4)
				o.MouseButton1Click:Connect(function() pick(opt) end)
			end

			btn.MouseButton1Click:Connect(function()
				open = not open
				listFrame.Visible = open
			end)

			if flag then Window._configFlags[flag] = selected end
			return {
				Set = function(_, v) pick(v) end,
				Get = function() return selected end,
			}
		end

		function Tab:Textbox(opts)
			opts = opts or {}
			local nameX = opts.Name or opts.Title or "Input"
			local placeholder = opts.Placeholder or ""
			local flag = opts.Flag
			local cb = opts.Callback
			local card = addCard()
			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, 0, 0, 16)
			lbl.BackgroundTransparency = 1
			lbl.Text = nameX
			lbl.Font = Enum.Font.GothamMedium
			lbl.TextSize = 12
			lbl.TextColor3 = THEME.dim
			lbl.TextXAlignment = Enum.TextXAlignment.Left
			lbl.ZIndex = 5
			lbl.Parent = card

			local box = Instance.new("TextBox")
			box.Size = UDim2.new(1, 0, 0, 30)
			box.BackgroundColor3 = THEME.element
			box.PlaceholderText = placeholder
			box.PlaceholderColor3 = THEME.mute
			box.Text = opts.Default or ""
			box.TextColor3 = THEME.text
			box.Font = Enum.Font.Gotham
			box.TextSize = 12
			box.ClearTextOnFocus = false
			box.ZIndex = 5
			box.Parent = card
			corner(box, 6)
			pad(box, 0, 0, 8, 8)

			box.FocusLost:Connect(function(enter)
				if flag then Window._configFlags[flag] = box.Text end
				if cb then pcall(cb, box.Text, enter) end
			end)
			return box
		end

		return Tab
	end

	--==========================================================
	-- CONFIG TAB (MM2 style)
	--==========================================================
	function Window:CreateConfigTab(opts)
		opts = opts or {}
		local tab = self:CreateTab({
			Name = opts.Name or "Config",
			Icon = opts.Icon or "save",
			Order = opts.Order or 99,
			NoGreen = true,
		})

		tab:Label("Save / Load / Delete configs (executor writefile)")

		local cfgName = "default"
		local nameBox = tab:Textbox({
			Name = "Config name",
			Placeholder = "default",
			Default = "default",
			Callback = function(t)
				cfgName = (t and t:gsub("%s+", "") ~= "") and t:gsub("%s+", "") or "default"
			end,
		})

		tab:Button({
			Name = "Save Config",
			Callback = function()
				pcall(function()
					if isfolder and not isfolder(folder) then makefolder(folder) end
					if writefile then
						writefile(folder .. "/" .. cfgName .. ".json", HttpService:JSONEncode({
							savedAt = os.date("%c"),
							name = cfgName,
							flags = Window._configFlags,
						}))
					end
				end)
				Window:Notify("Saved: " .. cfgName, true)
			end,
		})

		tab:Button({
			Name = "Load Config",
			Callback = function()
				local ok, data = pcall(function()
					return HttpService:JSONDecode(readfile(folder .. "/" .. cfgName .. ".json"))
				end)
				if ok and type(data) == "table" and type(data.flags) == "table" then
					for k, v in pairs(data.flags) do
						Window._configFlags[k] = v
					end
					Window:Notify("Loaded: " .. cfgName, true)
				else
					Window:Notify("Load failed: " .. cfgName, false)
				end
			end,
		})

		tab:Button({
			Name = "Delete Config",
			Callback = function()
				pcall(function()
					if delfile then delfile(folder .. "/" .. cfgName .. ".json") end
				end)
				Window:Notify("Deleted: " .. cfgName, false)
			end,
		})

		return tab
	end

	function Window:SelectTab(name)
		if Window._pages[name] then setActiveTab(name) end
	end

	function Window:SetVisible(v) setVisible(v) end

	-- Select first tab after short delay
	task.defer(function()
		if #Window._tabs > 0 then
			setActiveTab(Window._tabs[1])
		end
	end)

	return Window
end

