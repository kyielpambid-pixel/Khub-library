		function Tab:Toggle(opts)
			opts = opts or {}
			local nameT = opts.Name or opts.Title or "Toggle"
			local default = opts.Default or false
			local flag = opts.Flag
			local cb = opts.Callback

			local card = addCard()
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, 28)
			row.BackgroundTransparency = 1
			row.ZIndex = 5
			row.Parent = card

			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, -56, 1, 0)
			lbl.BackgroundTransparency = 1
			lbl.Text = nameT
			lbl.Font = Enum.Font.GothamMedium
			lbl.TextSize = 13
			lbl.TextColor3 = THEME.text
			lbl.TextXAlignment = Enum.TextXAlignment.Left
			lbl.ZIndex = 6
			lbl.Parent = row

			local state = default
			local switch = Instance.new("TextButton")
			switch.Size = UDim2.new(0, 46, 0, 24)
			switch.Position = UDim2.new(1, -46, 0.5, -12)
			switch.BackgroundColor3 = state and THEME.accent or THEME.off
			switch.Text = ""
			switch.ZIndex = 6
			switch.Parent = row
			corner(switch, 12)

			local knob = Instance.new("Frame")
			knob.Size = UDim2.new(0, 18, 0, 18)
			knob.Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
			knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			knob.ZIndex = 7
			knob.Parent = switch
			corner(knob, 9)

			local function apply(v, silent)
				state = v
				TweenService:Create(switch, TweenInfo.new(0.15), {
					BackgroundColor3 = state and THEME.accent or THEME.off
				}):Play()
				TweenService:Create(knob, TweenInfo.new(0.15), {
					Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
				}):Play()
				if flag then Window._configFlags[flag] = state end
				if not silent then
					pushToast(ToastHost, nameT, state)
				end
				if cb then pcall(cb, state) end
			end

			switch.MouseButton1Click:Connect(function()
				apply(not state, false)
			end)

			if flag then Window._configFlags[flag] = state end
			return {
				Set = function(_, v) apply(v, true) end,
				Get = function() return state end,
			}
		end

