	card     = Color3.fromRGB(16, 20, 36),
	element  = Color3.fromRGB(18, 22, 40),
	accent   = Color3.fromRGB(160, 90, 255),   -- violet
	accent2  = Color3.fromRGB(120, 60, 220),
	green    = Color3.fromRGB(80, 220, 140),
	gold     = Color3.fromRGB(255, 216, 140),
	text     = Color3.fromRGB(238, 242, 255),
	dim      = Color3.fromRGB(150, 160, 205),
	mute     = Color3.fromRGB(100, 112, 158),
	stroke   = Color3.fromRGB(100, 70, 180),
	red      = Color3.fromRGB(255, 100, 120),
	off      = Color3.fromRGB(38, 44, 70),
